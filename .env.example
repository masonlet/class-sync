# Required
## Bot token from Discord Developer Portal (Bot tab)
DISCORD_TOKEN=bot_token_here

## Application ID from Discord Developer Portal (General Information tab)
CLIENT_ID=your_application_id_here

# Optional
## Server ID for instant command updates during development
GUILD_ID=server_id_here

## Role name that can manage deadlines
HELPER_ROLE_NAME=role_name_here

# Optional intervals in minutes
CLEANUP_INTERVAL_MINUTES=30
REMINDER_INTERVAL_MINUTES=30